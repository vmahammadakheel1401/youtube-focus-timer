{
  "manifest_version": 3,
  "name": "YouTube Focus Timer",
  "description": "Automatically limits YouTube usage and blocks it after the watch timer ends.",
  "version": "1.0.0",

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Focus Timer"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "blocked.html"
    ],
    "matches": [
      "<all_urls>"
    ]
  }
],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}